# ============================================================
# Smart File Converter — Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render: set these in the Render dashboard under
#   "Environment" tab, OR they are set in render.yaml.
#
# NEVER commit your actual .env file to Git.
# .env is already in .gitignore.
# ============================================================

# ── Server ─────────────────────────────────────────────────
# [RENDER FIX #3] PORT must come from environment, not hardcoded.
# Render injects $PORT automatically (usually 10000).
# Locally: set to 3000 or leave unset (server defaults to 3000).
PORT=3000

# ── Environment ────────────────────────────────────────────
# "production" → hides stack traces from API responses (shown in logs)
# "development" → shows full error details in API responses
NODE_ENV=development

# ── [RENDER FIX #2] Temp Directory ─────────────────────────
# Where uploads and converted files are stored temporarily.
# On Render/Linux: /tmp (always writable in Docker containers)
# On Windows local dev: leave unset → os.tmpdir() is used automatically
# TEMP_DIR=/tmp

# ── [RENDER FIX #1] LibreOffice binary path ─────────────────
# Full path to the soffice binary.
# On Render Debian Docker: /usr/bin/soffice (installed via apt)
# On macOS (brew): /Applications/LibreOffice.app/Contents/MacOS/soffice
# On Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Leave unset → libreoffice-convert will auto-detect from PATH
# SOFFICE_PATH=/usr/bin/soffice

# ── File Limits ─────────────────────────────────────────────
# Informational — actual limits are enforced in code.
MAX_FILE_SIZE_MB=100

# ── CORS ────────────────────────────────────────────────────
# For production, restrict to your actual domain.
# Example: https://smart-file-converter.onrender.com
# Leave unset or set to "true" to allow all origins (dev-friendly).
# ALLOWED_ORIGIN=https://your-app.onrender.com
